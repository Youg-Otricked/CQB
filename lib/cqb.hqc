#link<./libcqb.a>
namespace Exported {
    #include<Vector, std>
}
#nomain
namespace CQB {
    namespace Build {
        struct Command {
            char* targetName;
            char* commandBin;
            Vector::Vec<char*> inputs;
            char* outputArtifact;
            Vector::Vec<char*> flags;
            Vector::Vec<char*> dependencies;
        };
        class Builder {
            private char* project;
            private Vector::Vec<Command> commands;
            private Command& current_command();
            Builder();
            Builder* project(char* name);
            Builder* alias(char* fileName, char* aliasName);
            Builder* aliasDir(char* dirName, char* aliasName);
            Builder* define(char* to_define);
            Builder* linkDir(char* to_link);
            Builder* link(char* to_link);
            Builder* include(char* to_inc);
            Builder* linkerFlag(char* to_flag);
            Builder* warn(char* to_warn);
            Builder* noWarn(char* to_warn);
            Builder* error(char* to_error);
            Builder* cArgs();
            Builder* addExecutable(char* outputName, Vector::Vec<char*> sourceFiles);
            Builder* addObject(char* outputName, Vector::Vec<char*> sourceFiles);
            Builder* addStaticLibrary(char* outputName, Vector::Vec<char*> objectFiles);
            Builder* addDynamicLibrary(char* outputName, Vector::Vec<char*> sourceFiles);
            Builder* targetFlags(Vector::Vec<char*> targetFlags);
            Builder* addCustomCommand(char* targetName, char* commandBin, char* outputArtifact);
            Builder* flag(char* flag);
            Builder* addCDependency(char* targetName, Vector::Vec<char*> cSourceFiles);
            Builder* dependsOn(char* dependencyName);
            Vector::Vec<Command> extractGraph();
        };
    }
    namespace CI {
        struct Step {
            char* name;
            Vector::Vec<char*> command;
        };
        struct Task {
            char* name;
            Vector::Vec<Step> steps;
            Vector::Vec<Task*> next;
            bool ignoreFailure;
        };
        class Job {
            private Vector::Vec<Task*> tasks;
            private Task *entry;
            private Task *current;
            Job(char* name, Vector::Vec<Step> steps);
            Task* addTask(char* name, Vector::Vec<Step> steps, bool advance = false);
            Job* focus(Task* task);
            Job* link(Task* parent, Task* child);
            Task* getGraphRoot();
        };
    }
    namespace Engine {
        struct TaskState {
            char* name;
            char* category;     
            char* status;
            int progress;        
            char* lastOutput;   
            Vector::Vec<char*> logHistory; 
            int warningsCount;
            int errorsCount;
        };
        struct RunResult {
            int exitCode;
            char* output;
        };
        RunResult runCommand(Vector::Vec<char*> args, char* label, bool tty);
        class Runner {
            bool ciDone;
            bool buildDone;
            CI::Task* ciRoot;
            Vector::Vec<TaskState> activeStates;
            CI::Task* activeTask;
            Vector::Vec<Build::Command> buildGraph;
            int indexOf(Vector::Vec<Build::Command>& g, char* name);
            int runBuildPipeline();
            int runCIPipeline();
            Runner(Vector::Vec<Build::Command> build, CI::Task *ciRoot);
            bool Run();
        };
    }
}
